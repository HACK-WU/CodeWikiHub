  "cards": [
    {
      "dot": "cyan",
      "title": "幂等追加承载增量",
      "items": [
        "同 sourcePath 重导 = 覆盖更新；同名不同源 = 真冲突跳过；新文件 = 新增",
        "重复执行同一条命令就是增量更新，不再依赖 git diff"
      ]
    },
    {
      "dot": "rose",
      "title": "覆盖导入是 scope 级清空",
      "items": [
        "dense 模式下 scope 已有向量会先清空再重建",
        "跨批次导入不同 group 时，前次文件不在本次源目录内就会丢向量"
      ]
    },
    {
      "dot": "orange",
      "title": "中断怎么恢复",
      "items": [
        "被 kill 时写 import-interrupt.json，并同步清锁",
        "下次打开向量库会被引导执行 ki restore --rebuild-vector"
      ]
    }
  ]
