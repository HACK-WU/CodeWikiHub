  "cards": [
    {
      "dot": "orange",
      "title": "常驻不等于守护",
      "items": [
        "--daemon 只做 detached spawn：日志不落盘、崩溃不自动拉起",
        "排查「改动没生效」先 ki mcp restart，长驻进程仍跑旧代码"
      ]
    },
    {
      "dot": "emerald",
      "title": "三层并发闸门",
      "items": [
        "向量库：空闲 3s 释放锁 + 撞锁重试 2s×3",
        "scope 写锁：同 scope 的 import / sync / edit 串行",
        "operation-coordinator：跨操作统一分类与排队"
      ]
    },
    {
      "dot": "cyan",
      "title": "重启后会自己补的事",
      "items": [
        "resumeGovernanceTasks：接上未收口的事件分析",
        "resumePendingOnStartup：消费可见性队列残留",
        "markInterruptedTasks：把断在半路的任务标成中断"
      ]
    }
  ]
